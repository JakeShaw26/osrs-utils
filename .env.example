# ---------------------------------------------------------------------------
# OSRS Clan Toolkit — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must never
# be committed. No value in this file is a real secret.
#
# Rule: nothing secret may be prefixed NEXT_PUBLIC_ — Next.js inlines those
# into the client bundle, publishing them to every visitor.
#
# The app has no authentication (ADR-0012). There are no OAuth credentials and
# no session secret, because there are no sessions.
# ---------------------------------------------------------------------------

# --- Clan identity ---------------------------------------------------------
# The clan's Wise Old Man group ID — the numeric part of its URL:
#   https://wiseoldman.net/groups/82   ->   82
# This is the app's entire notion of "the clan". Membership of this group is
# the roster, and the group's roleOrders supply the rank hierarchy. (ADR-0012)
WOM_GROUP_ID="82"

# --- Database (Neon / Supabase Postgres) -----------------------------------
# POOLED connection string. Required for serverless routes: each function
# instance opens its own connection, and the direct endpoint runs out of
# connections under concurrency. (PRD §4.2)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/osrs_toolkit?sslmode=require"

# DIRECT (unpooled) connection. Used only by drizzle-kit for migrations —
# schema changes need a real session, which a transaction pooler can't give.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/osrs_toolkit?sslmode=require"

# --- Scheduled jobs --------------------------------------------------------
# Sent by the scheduler as `Authorization: Bearer <secret>`. Cron routes are
# public HTTPS URLs, and with no user auth these are the ONLY writers in the
# system — so this check is the whole write-side security model. Without it,
# anyone can trigger our refresh loop and burn the upstream rate-limit budget
# on our behalf. (ADR-0012, PRD §4.5)
CRON_SECRET="replace-me-with-a-long-random-string"

# --- Third-party APIs ------------------------------------------------------
# Optional. Raises Wise Old Man's limit from 20 to 100 requests/minute.
# Group reads work fine unauthenticated; this is headroom, not a requirement.
# Request one via the WOM Discord. (PRD §2.5)
WOM_API_KEY=""

# REQUIRED. The OSRS Wiki blocks default agents (curl, python-requests, Java…)
# and asks for a description plus contact info. Sent on every wiki request.
# Format: "<app>/<version> (+<url>; discord: <handle>)"  (PRD §2.1)
OSRS_API_USER_AGENT="osrs-clan-toolkit/0.1 (+https://example.com; discord: yourhandle)"
